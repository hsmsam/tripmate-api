Content-Type: application/json

{
  "trip": {
    "id": 2
  },
  "title": "Visit the Louvre Museum",
  "activity": "SIGHTSEEING",
  "price": 0,
  "rating": 4.5,
  "review": "Louvre Museum needs no reviews. Visiting the Louvre Museum was an amazing experience! Seeing all the stunning architecture and incredible paintings from renowned artists, some over 500 years old, was truly magical. It's great that entry is free, just remember to book your tickets in advance. Highly recommend!"
}

